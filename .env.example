# ============================================================
# LLM Gateway - example environment
# Copy to .env and fill in. .env is gitignored; never commit it.
# ============================================================

# ---- The fallback chain (the only required setting) --------
# Ordered "provider:model" rungs, comma-separated.
# Rung 1 is primary; each later rung is tried when a rung fails
# with a RETRYABLE error (429 / 5xx / timeout). A non-retryable
# error (400 / 401 / 403) fails fast without falling over.
#
# Start with ONE rung, confirm it works, then add fallbacks:
LLM_CHAIN="anthropic:claude-sonnet-4-6"
#
# A realistic cross-provider chain (cheap+fast primary, then
# a different vendor so a provider-wide outage doesn't take you down):
# LLM_CHAIN="openai:gpt-5.6-luna,anthropic:claude-sonnet-4-6,bedrock:us.anthropic.claude-sonnet-4-5-v1:0"
#
# Model IDs verified July 2026 - they change often, so confirm before use:
#   Anthropic : claude-sonnet-4-6 (balanced default)
#               claude-haiku-4-5-20251001 (cheapest/fastest)
#               claude-opus-4-8 (most capable)
#   OpenAI    : gpt-5.6-luna (cheapest)  gpt-5.6-terra (balanced)
#               gpt-5.6-sol (flagship; `gpt-5.6` is an alias for it)
#   Bedrock   : region-prefixed inference profile IDs, e.g.
#               us.anthropic.claude-sonnet-4-5-v1:0
#               List yours with:
#               aws bedrock list-inference-profiles --region us-east-1

# ---- Provider credentials ----------------------------------
# Only required for providers that actually appear in LLM_CHAIN.
# The app builds every client at startup, so a missing key for a
# listed provider is a hard ValueError on boot (fail fast, by design).

# https://console.anthropic.com -> API keys  (starts with sk-ant-)
ANTHROPIC_API_KEY=

# https://platform.openai.com -> API keys  (starts with sk-proj- or sk-)
OPENAI_API_KEY=

# ---- AWS Bedrock -------------------------------------------
# No key in this file. boto3 uses the standard AWS credential chain:
#   1. AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars
#   2. ~/.aws/credentials  (run: aws configure)
#   3. IAM role  <- what you use on ECS/Lambda in production
# Region matters: model availability and IDs differ per region.
AWS_REGION=ap-south-1